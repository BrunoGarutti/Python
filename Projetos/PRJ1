#Calculadora de multas

def calcular_infracao(velocidade, max, m1):
    if max < velocidade <= max * 1.20:
        resultado = "Infração leve"
        multa = 130.16
        ponto = "não perderá nenhum ponto na carteira"
    elif max * 1.20 < velocidade <= max * 1.50:
        resultado = "Infração grave"
        multa = 195.23
        ponto = "perderá 5 pontos na carteira"
        if m1 == "sim":
            multa = multa * 2
    elif velocidade > max * 1.50:
        resultado = "Infração gravíssima"
        multa = 880.41
        ponto = "perderá 7 pontos na carteira, assim então tendo sua CNH suspensa"
        if m1 == "sim":
            multa = multa * 2
    else:
        resultado = "Sem infração"
        multa = 0.0
        ponto = "não perderá nenhum ponto na carteira"

    return resultado, multa, ponto

